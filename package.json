{
  "name": "@mdesign/react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Independent React and TypeScript UI kit inspired by mObywatel, with mobile, portal and landing components",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "bun run build:showcase && storybook dev -p 5173 --host 127.0.0.1 --no-open --disable-telemetry",
    "build": "bun run tokens:generate && bun run catalog:api && bun run stories:generate && bun run typecheck && bun run build:showcase && bun run build:storybook && bun run build:lib",
    "build:lib": "bun run tokens:generate && vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/build-artifacts.mjs",
    "typecheck": "tsc -b",
    "preview": "vite preview --outDir dist/storybook --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "catalog:api": "node scripts/generate-api-catalog.mjs",
    "verify:coverage": "bun run catalog:api && node scripts/verify-coverage.mjs",
    "dev:showcase": "vite --host 127.0.0.1 --port 5174",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "build:showcase": "vite build --config vite.showcase.config.ts && node scripts/prepare-showcase.mjs",
    "build:storybook": "storybook build --output-dir dist/storybook --disable-telemetry",
    "tokens:generate": "node scripts/generate-tokens.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs --check",
    "test:tokens": "node --test scripts/generate-tokens.test.mjs",
    "stories:generate": "node scripts/generate-stories.mjs",
    "verify:stories": "node scripts/generate-stories.mjs --check",
    "test:stories": "vitest run --config vitest.storybook.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:visual": "vitest run --config vitest.visual.config.ts",
    "test:coverage": "vitest run --coverage",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "bun run lint && bun run format:check && bun run tokens:check && bun run docs:check && bun run test:tooling && bun run verify:coverage && bun run verify:stories && bun run typecheck && bun run test",
    "test:explorer": "node scripts/verify-explorer.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:tooling": "node --test scripts/*.test.mjs",
    "prepack": "bun run tokens:check && bun run catalog:api && bun run verify:stories && bun run build:lib",
    "pack:lib": "node scripts/pack-library.mjs",
    "release:check": "bun run verify && bun run pack:lib && bun run verify:package",
    "test:visual:retained": "node scripts/test-retained-visual.mjs",
    "docs:check": "node scripts/check-doc-links.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./styles.css": {
      "types": "./dist/lib/styles.d.ts",
      "default": "./dist/lib/mdesign.css"
    },
    "./tokens.json": "./src/kit/tokens.json",
    "./native-icons/*": "./src/kit/native-icons/*",
    "./official-mobile-colors.json": "./dist/lib/official-mobile-colors.json",
    "./portal": {
      "types": "./dist/lib/portal/index.d.ts",
      "import": "./dist/lib/portal.js"
    },
    "./mobile": {
      "types": "./dist/lib/mobile/index.d.ts",
      "import": "./dist/lib/mobile.js"
    },
    "./landing": {
      "types": "./dist/lib/landing/index.d.ts",
      "import": "./dist/lib/landing.js"
    },
    "./icons": {
      "types": "./dist/lib/OfficialIcon.d.ts",
      "import": "./dist/lib/icons.js"
    },
    "./official-icons/*": "./src/kit/official-icons/*",
    "./tokens.dtcg.json": "./dist/lib/tokens.dtcg.json"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.59.0",
    "qrcode": "^1.5.4",
    "@floating-ui/react-dom": "^2.1.9"
  },
  "devDependencies": {
    "@blazediff/core": "1.9.1",
    "@eslint/js": "10.0.1",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jsbarcode": "^3.11.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "^26.1.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "10.6.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "8.72.0",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  },
  "files": [
    "LICENSE",
    "dist/lib",
    "src/kit/tokens.json",
    "src/kit/web-tokens.css",
    "src/kit/fonts/OFL-OpenSans.txt",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "docs/REFERENCES.md",
    "public/provenance.json",
    "src/kit/native-icons",
    "src/kit/document-assets",
    "src/kit/service-icons",
    "src/kit/official-icons",
    "src/kit/landing/provenance.json",
    "src/kit/mobile/coverage.json",
    "src/kit/portal/coverage.json",
    "src/kit/landing/coverage.json",
    "docs/COMPONENT-COVERAGE.md",
    "src/kit/landing/fonts/OFL-Lato.txt",
    "src/kit/licenses",
    "src/kit/portal/provenance.json",
    "src/catalog/component-manifest.json",
    "src/kit/portal/assets",
    "src/kit/landing/assets",
    "src/kit/mobile/README.md",
    "src/kit/tokens.dtcg.json",
    "docs/DEVELOPMENT.md",
    "docs/TOKENS.md",
    "CHANGELOG.md",
    "docs/images",
    "public/brand",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slominskiwiktor/mdesign-react.git"
  },
  "homepage": "https://slominskiwiktor.github.io/mdesign-react/",
  "bugs": {
    "url": "https://github.com/slominskiwiktor/mdesign-react/issues"
  }
}
